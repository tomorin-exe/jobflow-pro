# Copy to .env.local and replace the placeholder locally. Never commit real credentials.
# Percent-encode special characters in the password (for example @, #, / and %).
# Use the application role jobflow_app, not the postgres administrator role.
DATABASE_URL="postgresql://jobflow_app:YOUR_URL_ENCODED_PASSWORD@localhost:5432/jobflow_db?schema=public"

# Generate a random secret locally (at least 32 characters). Do not use this placeholder.
BETTER_AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
# Use the same origin in the browser. Restart Next.js after editing .env.local.
BETTER_AUTH_URL="http://localhost:3000"
