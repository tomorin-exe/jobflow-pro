{
  "name": "jobflow-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:api": "node --test tests/api.test.mjs",
    "test:db": "node --conditions=react-server --import tsx --test tests/database.test.ts tests/job-repository.test.ts tests/auth.test.ts",
    "test:auth": "node --conditions=react-server --import tsx --test tests/auth.test.ts",
    "postinstall": "prisma generate",
