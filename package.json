{
  "name": "jobflow-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25", "npm": ">=11" },
  "allowScripts": { "@prisma/engines": true, "prisma": true, "esbuild": true },
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:api": "node --test tests/api.test.mjs",
    "test:db": "node --conditions=react-server --import tsx --test tests/database.test.ts tests/job-repository.test.ts tests/auth.test.ts tests/auth-form.test.ts",
    "test:auth": "node --conditions=react-server --import tsx --test tests/auth.test.ts tests/auth-form.test.ts",
    "test:auth:http": "node --conditions=react-server --import tsx --test tests/auth-http.test.ts",
    "test:jobs": "node --conditions=react-server --import tsx --test tests/job-api.test.ts",
    "test:jobs:http": "node --conditions=react-server --import tsx --test tests/jobs-http.test.ts",
    "test:remote-jobs": "node --import tsx --test tests/remote-jobs.test.ts",
    "test:csv": "node --import tsx --test tests/job-csv.test.ts",
    "test:import:unit": "node --conditions=react-server --import tsx --test tests/job-import-unit.test.ts",
    "test:import:db": "node --conditions=react-server --import tsx --test tests/job-import.test.ts",
    "test:import:http": "node --conditions=react-server --import tsx --test tests/job-import-http.test.ts",
    "test:otp": "node --conditions=react-server --import tsx --test tests/otp-form.test.ts tests/email-otp.test.ts",
    "test:all": "node scripts/run-tests.mjs",
    "test:http": "node scripts/run-http-tests.mjs",
    "audit:repo": "node scripts/security-audit.mjs",
    "check:ci": "node scripts/check-ci.mjs",
    "ci:db:prepare": "node scripts/ci-database.mjs prepare",
    "ci:db:migrate": "node scripts/ci-database.mjs migrate",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.25",
    "@next/env": "16.4.6",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.25",
    "csv-parse": "7.0.3",
    "next": "^16.0.0",
    "nodemailer": "^10.6.0",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/smtp-server": "3.5.13",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "js-yaml": "4.3.2",
    "prisma": "7.10.1",
    "smtp-server": "3.21.6",
    "tailwindcss": "^4.1.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  }
}
